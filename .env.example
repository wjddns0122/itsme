# Copy to .env.local and fill in. Never commit real keys.
# Variable meanings: docs/04-architecture.md §3

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used by .mcp.json (read-only Supabase MCP scoped to this project)
SUPABASE_PROJECT_REF=
# pnpm db:seed: password for the demo admin accounts (admin.<slug>@example.com). 10+ characters.
SEED_ADMIN_PASSWORD=

# AI
GEMINI_API_KEY=
# free: team test data only / paid: real user data allowed (ADR-025)
GEMINI_TIER=free
# Production only: last Seoul date a free key may serve the deployed site (hackathon demo, ADR-025). Leave empty otherwise.
GEMINI_FREE_DEMO_UNTIL=
VISION_MODEL=gemini-4-hydrogen
LLM_MODEL=gemini-4-hydrogen
# Stage 2 (embedding search, ADR-023)
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=768

# Matching
MATCH_SAVE_THRESHOLD=0.45
MATCH_NOTIFY_THRESHOLD=0.70
COVERAGE_MIN_NOTIFY=0.65
AI_JUDGE_BATCH=20
AI_JUDGE_MAX_CANDIDATES=60

# Email
RESEND_API_KEY=
EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

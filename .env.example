# Copy to .env.local and fill in. Never commit real keys.
# Variable meanings: docs/04-architecture.md §3

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used by .mcp.json (read-only Supabase MCP scoped to this project)
SUPABASE_PROJECT_REF=

# AI
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
LLM_MODEL=claude-opus-5-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Matching
MATCH_SAVE_THRESHOLD=0.45
MATCH_NOTIFY_THRESHOLD=0.70

# Email
RESEND_API_KEY=
EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
